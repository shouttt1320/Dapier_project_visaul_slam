# ROS 2 Build & Workspace Artifacts
build/
install/
log/
.colcon/
robot_ws/build/
robot_ws/install/
robot_ws/log/

# Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.directory

# Temporary / Log files
*.log
/tmp/
.tempmediaStorage/
diagnostics/

# Large SLAM DB files (RTAB-Map)
*.db
*.db-shm
*.db-wal
*.bag

# Temporary Test Scripts & Hardware Checks
test_cmd_vel.py
test_dual_marker.py
test_marker_accuracy.py
run_pi_hardware_test.sh

# Unused Drivers, Simulation & Legacy Code
unused_drivers/
simulation/
robot_ws/src/redbox_navigator/legacy/

# Test / Dump media files
*.png
*.jpg
*.jpeg
*.pdf
*.gv

# Keep assets in package directories even if they match extensions
!robot_ws/src/**/materials/**/*
!robot_ws/src/**/models/**/*
!robot_ws/src/**/config/**/*
!robot_ws/src/**/worlds/**/*
!markers/**/*

# Large models, weights, and point clouds
weights/
*.pt
*.ply

# External vendor drivers
robot_ws/src/ros2_astra_camera/

# Local agent artifacts
.agents/
