<?xml version="1.0" ?>
<robot name="turtlebot3_dual_so101" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ==================================================================== -->
  <!-- Materials                                                            -->
  <!-- ==================================================================== -->
  <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="light_grey"><color rgba="0.7 0.7 0.7 1.0"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="aluminum"><color rgba="0.85 0.85 0.85 1.0"/></material>
  <material name="arm_orange"><color rgba="0.95 0.45 0.1 1.0"/></material>

  <!-- ==================================================================== -->
  <!-- 1. Mobile Base: TurtleBot3 Waffle Pi                                  -->
  <!-- ==================================================================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.010" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="-0.064 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="waffle_pi_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="-0.064 0 0.047" rpy="0 0 0"/>
      <geometry>
        <box size="0.266 0.266 0.094"/>
      </geometry>
    </collision>
    <!-- 양팔과 프로파일 하중을 견디기 위한 안정적인 무게중심 카운터웨이트 (4.0kg) -->
    <inertial>
      <origin xyz="-0.04 0 0.02" rpy="0 0 0"/>
      <mass value="4.0"/>
      <inertia ixx="0.035" ixy="0.0" ixz="0.0" iyy="0.035" iyz="0.0" izz="0.045"/>
    </inertial>
  </link>

  <!-- Left Wheel -->
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0.0 0.144 0.023" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="left_tire.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Right Wheel -->
  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0.0 -0.144 0.023" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="right_tire.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Front/Back Casters -->
  <joint name="caster_back_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back_link"/>
    <origin xyz="-0.177 0 -0.004" rpy="-1.5708 0 0"/>
  </joint>
  <link name="caster_back_link">
    <collision>
      <origin xyz="0 0.001 0" rpy="0 0 0"/>
      <geometry><box size="0.030 0.009 0.020"/></geometry>
    </collision>
    <inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <!-- ==================================================================== -->
  <!-- 2. Aluminum Profile Central Frame (20x20 pillar, 400mm height)        -->
  <!-- ==================================================================== -->
  <joint name="profile_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="profile_frame_link"/>
    <origin xyz="-0.04 0.0 0.095" rpy="0 0 0"/>
  </joint>

  <link name="profile_frame_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="al_profile_frame.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="aluminum"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.40"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.20"/>
      <mass value="0.8"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.001"/>
    </inertial>
  </link>


  <!-- ==================================================================== -->
  <!-- 3. SO-101 Arm Xacro Macro (6 DOF per Arm)                            -->
  <!-- ==================================================================== -->
  <xacro:macro name="so101_arm" params="prefix parent *origin">
    
    <!-- Arm Base Mount Joint -->
    <joint name="${prefix}mount_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
    </joint>

    <link name="${prefix}base_link">
      <visual>
        <origin xyz="-0.00636 -8.97e-09 -0.0024" rpy="1.5708 0 1.5708"/>
        <geometry>
          <mesh filename="base_so101_tj.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="arm_orange"/>
      </visual>
      <collision>
        <origin xyz="-0.00636 -8.97e-09 -0.0024" rpy="1.5708 0 1.5708"/>
        <geometry>
          <mesh filename="base_so101_tj.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0029 0.0001 0.0242"/>
        <mass value="0.12"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Shoulder Pan Joint -->
    <joint name="${prefix}shoulder_pan" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}shoulder_link"/>
      <origin xyz="0.0388 0 0.0624" rpy="3.14159 0 -3.14159"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.919" upper="1.919" effort="10.0" velocity="4.0"/>
    </joint>

    <link name="${prefix}shoulder_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="motor_holder_so101_base_v1.stl"/>
        </geometry>
        <material name="arm_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="motor_holder_so101_base_v1.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.015 -0.009 -0.027"/>
        <mass value="0.15"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Shoulder Lift Joint -->
    <joint name="${prefix}shoulder_lift" type="revolute">
      <parent link="${prefix}shoulder_link"/>
      <child link="${prefix}upper_arm_link"/>
      <origin xyz="-0.0304 -0.0183 -0.0542" rpy="-1.5708 -1.5708 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.22" upper="1.57" effort="15.0" velocity="4.0"/>
    </joint>

    <link name="${prefix}upper_arm_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="upper_arm_so101_v1.stl"/>
        </geometry>
        <material name="arm_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="upper_arm_so101_v1.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.06 -0.015 0"/>
        <mass value="0.18"/>
        <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Elbow Flex Joint -->
    <joint name="${prefix}elbow_flex" type="revolute">
      <parent link="${prefix}upper_arm_link"/>
      <child link="${prefix}lower_arm_link"/>
      <origin xyz="-0.1126 -0.028 0" rpy="0 0 1.5708"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.57" upper="1.57" effort="10.0" velocity="4.0"/>
    </joint>

    <link name="${prefix}lower_arm_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="under_arm_so101_v1.stl"/>
        </geometry>
        <material name="arm_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="under_arm_so101_v1.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.065 0.002 0"/>
        <mass value="0.14"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Wrist Flex Joint -->
    <joint name="${prefix}wrist_flex" type="revolute">
      <parent link="${prefix}lower_arm_link"/>
      <child link="${prefix}wrist_link"/>
      <origin xyz="-0.1349 0.0052 0" rpy="0 0 -1.5708"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.57" upper="1.57" effort="8.0" velocity="4.0"/>
    </joint>

    <link name="${prefix}wrist_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="motor_holder_so101_wrist_v1.stl"/>
        </geometry>
        <material name="arm_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="motor_holder_so101_wrist_v1.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 -0.03 0.01"/>
        <mass value="0.08"/>
        <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
      </inertial>
    </link>

    <!-- Wrist Roll Joint -->
    <joint name="${prefix}wrist_roll" type="revolute">
      <parent link="${prefix}wrist_link"/>
      <child link="${prefix}gripper_link"/>
      <origin xyz="0 -0.0611 0.0181" rpy="1.5708 0.0487 3.14159"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.919" upper="1.919" effort="5.0" velocity="4.0"/>
    </joint>

    <link name="${prefix}gripper_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="wrist_roll_pitch_so101_v2.stl"/>
        </geometry>
        <material name="arm_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="wrist_roll_pitch_so101_v2.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 -0.05"/>
        <mass value="0.10"/>
        <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
      </inertial>
    </link>

    <!-- Gripper Moving Jaw Joint -->
    <joint name="${prefix}gripper" type="revolute">
      <parent link="${prefix}gripper_link"/>
      <child link="${prefix}moving_jaw_link"/>
      <origin xyz="0.0202 0.0188 -0.0234" rpy="1.5708 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.17" upper="1.05" effort="8.0" velocity="4.0"/>
    </joint>

    <link name="${prefix}moving_jaw_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="moving_jaw_so101_v1.stl"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="moving_jaw_so101_v1.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 -0.02"/>
        <mass value="0.03"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>

  </xacro:macro>

  <!-- ==================================================================== -->
  <!-- 4. Instantiate Dual Arms on Aluminum Profile                         -->
  <!-- ==================================================================== -->
  
  <!-- Left Arm (Y = +0.10m, Z = 0.25m, 앞을 향하도록 장착) -->
  <xacro:so101_arm prefix="left_arm_" parent="profile_frame_link">
    <origin xyz="0.03 0.10 0.25" rpy="0 0 0.1745"/>
  </xacro:so101_arm>

  <!-- Right Arm (Y = -0.10m, Z = 0.25m, 앞을 향하도록 장착) -->
  <xacro:so101_arm prefix="right_arm_" parent="profile_frame_link">
    <origin xyz="0.03 -0.10 0.25" rpy="0 0 -0.1745"/>
  </xacro:so101_arm>

</robot>
