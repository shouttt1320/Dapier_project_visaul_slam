              </metal>
            </pbr>
          </material>
        </visual>
      </link>
      <!-- South Wall -->
      <link name="wall_south">
        <pose>0 -3 0.5 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>6 0.15 1.0</size></box></geometry>
